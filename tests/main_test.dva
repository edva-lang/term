// tests/main_test.dva — Verification suite for 'term'

#use io
#use str
#use sys
#use "../src/term"
#use "../src/color"

assert_eq: String, String, String => ()
assert_eq = name, got, expected =>
   got == expected
      | io::out("PASS: " + name)
      |
         io::err("FAIL: " + name + "\n  got:      " + got + "\n  expected: " + expected)
         sys::exit(1)

assert_true: String, <> => ()
assert_true = name, condition =>
   condition
      | io::out("PASS: " + name)
      |
         io::err("FAIL: " + name)
         sys::exit(1)

// --- Colors ---
assert_true("red", ?term::red("r") > 1)
assert_true("green", ?term::green("g") > 1)
assert_true("yellow", ?term::yellow("y") > 1)
assert_true("blue", ?term::blue("b") > 1)
assert_true("magenta", ?term::magenta("m") > 1)
assert_true("cyan", ?term::cyan("c") > 1)
assert_true("white", ?term::white("w") > 1)
assert_true("gray", ?term::gray("gr") > 2)

// --- Styles ---
assert_true("bold", ?term::bold("bld") > 3)
assert_true("dim", ?term::dim("dm") > 2)
assert_true("italic", ?term::italic("it") > 2)
assert_true("underline", ?term::underline("un") > 2)
assert_true("reverse", ?term::reverse("rev") > 3)
assert_true("strikethrough", ?term::strikethrough("st") > 2)

// --- Background colors ---
assert_true("term::bg_black", ?term::bg_black("k") > 1)
assert_true("term::bg_red", ?term::bg_red("r") > 1)
assert_true("term::bg_green", ?term::bg_green("g") > 1)
assert_true("term::bg_yellow", ?term::bg_yellow("y") > 1)
assert_true("term::bg_blue", ?term::bg_blue("b") > 1)
assert_true("term::bg_magenta", ?term::bg_magenta("m") > 1)
assert_true("term::bg_cyan", ?term::bg_cyan("c") > 1)
assert_true("term::bg_white", ?term::bg_white("w") > 1)

assert_true("color::bg_black", ?color::bg_black("k") > 1)
assert_true("color::bg_red", ?color::bg_red("r") > 1)
assert_true("color::bg_green", ?color::bg_green("g") > 1)
assert_true("color::bg_yellow", ?color::bg_yellow("y") > 1)
assert_true("color::bg_blue", ?color::bg_blue("b") > 1)
assert_true("color::bg_magenta", ?color::bg_magenta("m") > 1)
assert_true("color::bg_cyan", ?color::bg_cyan("c") > 1)
assert_true("color::bg_white", ?color::bg_white("w") > 1)

// --- Strip ANSI codes ---
styled = term::bold(term::red("important text"))
stripped = term::strip(styled)
assert_eq("strip removes codes", stripped, "important text")

// --- Terminal check ---
is_term = term::is_terminal(1)
is_term | io::out("PASS: is_terminal stdout") | io::out("PASS: is_terminal stdout (redirected)")

io::out("=== ALL TERM SUITE CHECKS PASSED ===")
