// term/src/input.dva — Stdin polling and ANSI escape sequence event decoding

#use libc
#use sys
#use str
#use color
#use "key"
#use "style"
#use "raw"

#public
   // Check if input is available on stdin with timeout (ms)
   poll_in: Int => <>
   poll_in = timeout_ms => sys::poll_in(0, timeout_ms)

   // Read 1 byte non-blocking if available
   read_byte_opt: Int => < Int | >
   read_byte_opt = timeout_ms =>
      !poll_in(timeout_ms) |-->
      b' = 0u8
      n = libc::read(0, &b', 1)
      n > 0 | <+ Int(b') +> | <-->

   // Parse decimal number until delimiter, returns (parsed_number, terminating_char)
   parse_decimal: Int => (Int, Int)
   parse_decimal = first_digit =>
      num' = first_digit - 48 // '0' = 48
      term_c' = 0
      16 @ i =>
         opt = read_byte_opt(50)
         opt
            | b =>
               b !< 48 && b !> 57
                  |
                     num' = num' * 10 + (b - 48)
                  |
                     term_c' = b
                     -->
            | -->
      (num', term_c')

   // Drain remaining bytes of an unhandled CSI sequence up to final byte (0x40..0x7E)
   drain_csi_tail: Int => ()
   drain_csi_tail = last_b =>
      last_b !< 0x40 && last_b !> 0x7E | --|
      32 @ i =>
         opt = read_byte_opt(20)
         opt
            | b =>
               b !< 0x40 && b !> 0x7E | -->
            | -->

   // Parse private CSI sequence: \e[?... (e.g. \e[?997;1n or \e[?997;2n from Mode 2031 / ?996n)
   parse_csi_private: () => key::Event
   parse_csi_private = !=>
      q_opt = read_byte_opt(50)
      q_opt
         | qb =>
            qb !< '0' && qb !> '9'
               |
                  d = parse_decimal(qb)
                  num = d.0
                  term_c = d.1
                  num == 997 && term_c == ';'
                     |
                        s_opt = read_byte_opt(50)
                        s_opt
                           | sb =>
                              sb !< '0' && sb !> '9'
                                 |
                                    ds = parse_decimal(sb)
                                    ds.1 == 'n'
                                       |
                                          scheme = ds.0
                                             [2] key::THEME_LIGHT
                                             | key::THEME_DARK
                                          key::ev_theme(scheme, style::COLOR_DEFAULT)
                                       |
                                          drain_csi_tail(ds.1)
                                          key::ev_none!
                                 |
                                    drain_csi_tail(sb)
                                    key::ev_none!
                           | key::ev_none!
                     |
                        drain_csi_tail(term_c)
                        key::ev_none!
               |
                  drain_csi_tail(qb)
                  key::ev_none!
         | key::ev_none!

   // Scale a 1..4 hex-digit XParseColor channel to 8-bit (0..255)
   scale_osc_channel: Int, Int => Int
   scale_osc_channel = val, digits =>
      digits
         [1] (val .<. 4) .|. val
         [2] val
         [3] val .>. 4
         [4] val .>. 8
         | 0

   // Parse 1..4 hex digits from s starting at start; returns (scaled_8bit, digit_count, next_index)
   parse_hex_channel: String, Int => (Int, Int, Int)
   parse_hex_channel = s, start =>
      n = ?s
      i' = start
      val' = 0
      digits' = 0
      4 @ step =>
         i' < n
            |
               d = color::hex_digit(s(i'))
               d !< 0
                  |
                     val' = (val' .<. 4) .|. d
                     digits' = digits' + 1
                     i' = i' + 1
                  | -->
            | -->
      (scale_osc_channel(val', digits'), digits', i')

   // Read OSC payload up to BEL (0x07), ST (\e\\), or 0x9C
   read_osc_payload: () => String
   read_osc_payload = !=>
      buf = {0x40}
      0x40 @ i =>
         opt = read_byte_opt(50)
         opt
            | b =>
               b
                  [7, 0x9C] -->
                  [27]
                     st_b = read_byte_opt(20)
                     -->
                  | buf += b
            | -->
      +buf

   // Parse OSC sequence after \e]: handles OSC 11 background color reply (\e]11;rgb:RRRR/GGGG/BBBB\e\\)
   parse_osc: () => key::Event
   parse_osc = !=>
      s = read_osc_payload!
      n = ?s
      n !< 12 && s(..7) == "11;rgb:"
         |
            ch_r = parse_hex_channel(s, 7)
            ch_r.1 > 0 && ch_r.2 < n && s(ch_r.2) == '/'
               |
                  ch_g = parse_hex_channel(s, ch_r.2 + 1)
                  ch_g.1 > 0 && ch_g.2 < n && s(ch_g.2) == '/'
                     |
                        ch_b = parse_hex_channel(s, ch_g.2 + 1)
                        ch_b.1 > 0
                           |
                              bg = color::pack_rgb(ch_r.0, ch_g.0, ch_b.0)
                              scheme = color::luminance(bg) < 128 | key::THEME_DARK | key::THEME_LIGHT
                              key::ev_theme(scheme, bg)
                           | key::ev_none!
                     | key::ev_none!
               | key::ev_none!
         |
            n !< 10 && s(..4) == "11;#"
               |
                  bg = color::from_hex_str(s(3..n))
                  scheme = color::luminance(bg) < 128 | key::THEME_DARK | key::THEME_LIGHT
                  key::ev_theme(scheme, bg)
               | key::ev_none!

   // Parse SGR mouse event: \x1b[<{btn};{col};{row}{M|m}
   // '<' has already been consumed
   parse_sgr_mouse: () => key::Event
   parse_sgr_mouse = !=>
      b_opt = read_byte_opt(20)
      b_opt
         | b0 =>
            d1 = parse_decimal(b0)
            btn_raw = d1(0)
            b_opt2 = read_byte_opt(20)
            b_opt2
               | b1 =>
                  d2 = parse_decimal(b1)
                  col = d2(0)
                  b_opt3 = read_byte_opt(20)
                  b_opt3
                     | b2 =>
                        d3 = parse_decimal(b2)
                        row = d3(0)
                        term_char = d3(1) // 'M' or 'm'
                        is_release = term_char == 'm'

                        // Decode button & action
                        act' = is_release | key::MOUSE_RELEASE | key::MOUSE_PRESS
                        btn = (btn_raw .&. 3)
                           [0] key::MOUSE_BTN_LEFT
                           [1] key::MOUSE_BTN_MIDDLE
                           [2] key::MOUSE_BTN_RIGHT
                           | key::MOUSE_BTN_NONE

                        // Wheel events
                        (btn_raw .&. 64) != 0 |
                           (btn_raw .&. 1) != 0
                              | act' = key::MOUSE_SCROLL_DOWN
                              | act' = key::MOUSE_SCROLL_UP

                        // Drag
                        (btn_raw .&. 32) != 0 && !is_release |
                           act' = key::MOUSE_DRAG

                        // Modifiers
                        mods' = key::MOD_NONE
                        (btn_raw .&. 4) != 0 |
                           mods' = mods' .|. key::MOD_SHIFT
                        (btn_raw .&. 8) != 0 |
                           mods' = mods' .|. key::MOD_ALT
                        (btn_raw .&. 16) != 0 |
                           mods' = mods' .|. key::MOD_CTRL

                        key::ev_mouse(act', btn, mods', col, row)
                     | key::ev_none!
               | key::ev_none!
         | key::ev_none!

   decode_csi_letter: Int => key::Event
   decode_csi_letter = b2 =>
      b2
         ['A'] key::ev_code(key::KEY_UP)
         ['B'] key::ev_code(key::KEY_DOWN)
         ['C'] key::ev_code(key::KEY_RIGHT)
         ['D'] key::ev_code(key::KEY_LEFT)
         ['H'] key::ev_code(key::KEY_HOME)
         ['F'] key::ev_code(key::KEY_END)
         ['Z'] key::ev_key(key::KEY_BACKTAB, 0, key::MOD_SHIFT)
         ['P', 'p'] key::ev_code(key::KEY_F1)
         ['Q', 'q'] key::ev_code(key::KEY_F2)
         ['R', 'r'] key::ev_code(key::KEY_F3)
         ['S', 's'] key::ev_code(key::KEY_F4)
         | key::ev_none!

   decode_csi_num_key: Int => Int
   decode_csi_num_key = num =>
      num
         [27] key::KEY_ESC
         [1, 57382] key::KEY_HOME
         [2, 57362] key::KEY_INSERT
         [3, 57363] key::KEY_DELETE
         [4, 57383] key::KEY_END
         [5, 57380] key::KEY_PAGE_UP
         [6, 57381] key::KEY_PAGE_DOWN
         [11, 28, 57364] key::KEY_F1
         [12, 29, 57365] key::KEY_F2
         [13, 31, 57366] key::KEY_F3
         [14, 32, 57367] key::KEY_F4
         [15, 33, 57368] key::KEY_F5
         [17, 34, 57369] key::KEY_F6
         [18, 57370] key::KEY_F7
         [19, 57371] key::KEY_F8
         [20, 57372] key::KEY_F9
         [21, 57373] key::KEY_F10
         [23, 57374] key::KEY_F11
         [24, 57375] key::KEY_F12
         | key::KEY_NONE

   decode_fkey: Int => key::Event
   decode_fkey = fb =>
      fb
         ['P', 'p'] key::ev_code(key::KEY_F1)
         ['Q', 'q'] key::ev_code(key::KEY_F2)
         ['R', 'r'] key::ev_code(key::KEY_F3)
         ['S', 's'] key::ev_code(key::KEY_F4)
         [(_ !< '0' && _ !> '9')]
            d = parse_decimal(fb)
            term_c = d.1
            term_c
               ['P', 'p'] key::ev_code(key::KEY_F1)
               ['Q', 'q'] key::ev_code(key::KEY_F2)
               ['R', 'r'] key::ev_code(key::KEY_F3)
               ['S', 's'] key::ev_code(key::KEY_F4)
               | key::ev_none!
         | key::ev_none!

   decode_mod_arrow: Int, Int => key::Event
   decode_mod_arrow = fin_key, mods =>
      fin_key
         ['A'] key::ev_key(key::KEY_UP, 0, mods)
         ['B'] key::ev_key(key::KEY_DOWN, 0, mods)
         ['C'] key::ev_key(key::KEY_RIGHT, 0, mods)
         ['D'] key::ev_key(key::KEY_LEFT, 0, mods)
         | key::ev_none!

   parse_csi: () => key::Event
   parse_csi = !=>
      c_opt = read_byte_opt(50)
      c_opt
         | b2 =>
            b2
               ['<'] parse_sgr_mouse!
               ['?'] parse_csi_private!
               ['[']
                  f_opt = read_byte_opt(50)
                  f_opt
                     | fb =>
                        fb
                           ['A'] key::ev_code(key::KEY_F1)
                           ['B'] key::ev_code(key::KEY_F2)
                           ['C'] key::ev_code(key::KEY_F3)
                           ['D'] key::ev_code(key::KEY_F4)
                           ['E'] key::ev_code(key::KEY_F5)
                           | key::ev_none!
                     | key::ev_none!
               ['O']
                  f_opt = read_byte_opt(50)
                  f_opt
                     | fb => decode_fkey(fb)
                     | key::ev_none!
               |
                  csi_ev = decode_csi_letter(b2)
                  csi_ev.code != key::KEY_NONE | --| csi_ev
                  b2 !< '0' && b2 !> '9' |
                     d = parse_decimal(b2)
                     num = d.0
                     term_c = d.1
                     term_c
                        ['~']
                           k_code = decode_csi_num_key(num)
                           k_code != key::KEY_NONE | key::ev_code(k_code) | key::ev_none!
                        ['u']
                           num
                              [27] key::ev_code(key::KEY_ESC)
                              [13] key::ev_code(key::KEY_ENTER)
                              [9] key::ev_code(key::KEY_TAB)
                              [8, 127] key::ev_code(key::KEY_BACKSPACE)
                              [(_ !< 57344)]
                                 k_code = decode_csi_num_key(num)
                                 k_code != key::KEY_NONE | key::ev_code(k_code) | key::ev_char(num)
                              | key::ev_char(num)
                        ['P', 'p'] key::ev_code(key::KEY_F1)
                        ['Q', 'q'] key::ev_code(key::KEY_F2)
                        ['R', 'r'] key::ev_code(key::KEY_F3)
                        ['S', 's'] key::ev_code(key::KEY_F4)
                        [';']
                           c5 = read_byte_opt(50)
                           c5
                              | mod_b =>
                                 d_mod = parse_decimal(mod_b)
                                 mod_val = d_mod.0
                                 fin_key = d_mod.1
                                 mods = mod_val
                                    [2] key::MOD_SHIFT
                                    [3] key::MOD_ALT
                                    [5] key::MOD_CTRL
                                    | key::MOD_NONE
                                 fin_key
                                    ['~']
                                       k_code = decode_csi_num_key(num)
                                       key::ev_key(k_code, 0, mods)
                                    ['u']
                                       num
                                          [13] key::ev_key(key::KEY_ENTER, 0, mods)
                                          [9] key::ev_key(key::KEY_TAB, 0, mods)
                                          [27] key::ev_key(key::KEY_ESC, 0, mods)
                                          [8, 127] key::ev_key(key::KEY_BACKSPACE, 0, mods)
                                          [(_ !< 57344)]
                                             k_code = decode_csi_num_key(num)
                                             k_code != key::KEY_NONE | key::ev_key(k_code, 0, mods) | key::ev_char(num)
                                          [(_ !< 1 && _ !> 9)]
                                             mods == key::MOD_CTRL | key::ev_ctrl(num + 48) | key::ev_char(num)
                                          | (mods == key::MOD_CTRL | key::ev_ctrl(num) | key::ev_char(num))
                                    ['P', 'p'] key::ev_key(key::KEY_F1, 0, mods)
                                    ['Q', 'q'] key::ev_key(key::KEY_F2, 0, mods)
                                    ['R', 'r'] key::ev_key(key::KEY_F3, 0, mods)
                                    ['S', 's'] key::ev_key(key::KEY_F4, 0, mods)
                                    [';']
                                       num == 27
                                          |
                                             c6 = read_byte_opt(50)
                                             c6
                                                | key_b =>
                                                   d_key = parse_decimal(key_b)
                                                   code_val = d_key.0
                                                   code_val
                                                      [13] key::ev_key(key::KEY_ENTER, 0, mods)
                                                      [9] key::ev_key(key::KEY_TAB, 0, mods)
                                                      [27] key::ev_key(key::KEY_ESC, 0, mods)
                                                      [8] (mods == key::MOD_CTRL | key::ev_ctrl('h') | key::ev_key(key::KEY_BACKSPACE, 0, mods))
                                                      [127] key::ev_key(key::KEY_BACKSPACE, 0, mods)
                                                      [(_ !< 1 && _ !> 9)]
                                                         mods == key::MOD_CTRL | key::ev_ctrl(code_val + 48) | key::ev_char(code_val)
                                                      | (mods == key::MOD_CTRL | key::ev_ctrl(code_val) | key::ev_char(code_val))
                                                | key::ev_none!
                                          | key::ev_none!
                                    | decode_mod_arrow(fin_key, mods)
                              | key::ev_none!
                        | key::ev_none!
                  | key::ev_none!
         | key::ev_none!

   parse_escape_seq: () => key::Event
   parse_escape_seq = !=>
      p_opt = read_byte_opt(50)
      p_opt
         | b1 =>
            b1
               ['['] parse_csi!
               [']'] parse_osc!
               ['O']
                  f_opt = read_byte_opt(50)
                  f_opt
                     | fb => decode_fkey(fb)
                     | key::ev_none!
               | key::ev_key(key::KEY_CHAR, b1, key::MOD_ALT)
         | key::ev_code(key::KEY_ESC)

   // Decode multi-byte UTF-8 sequence starting with leading byte b0
   decode_utf8_char: Int => key::Event
   decode_utf8_char = b0 =>
      (b0 .&. 0xE0) == 0xC0
         |
            b1_opt = read_byte_opt(20)
            b1_opt
               | b1 => key::ev_char(((b0 .&. 0x1F) .<. 6) .|. (b1 .&. 0x3F))
               | key::ev_char(b0)
         |
            (b0 .&. 0xF0) == 0xE0
               |
                  b1_opt = read_byte_opt(20)
                  b2_opt = read_byte_opt(20)
                  b1_opt
                     | b1 =>
                        b2_opt
                           | b2 => key::ev_char(((b0 .&. 0x0F) .<. 12) .|. ((b1 .&. 0x3F) .<. 6) .|. (b2 .&. 0x3F))
                           | key::ev_char(b0)
                     | key::ev_char(b0)
               |
                  (b0 .&. 0xF8) == 0xF0
                     |
                        b1_opt = read_byte_opt(20)
                        b2_opt = read_byte_opt(20)
                        b3_opt = read_byte_opt(20)
                        b1_opt
                           | b1 =>
                              b2_opt
                                 | b2 =>
                                    b3_opt
                                       | b3 => key::ev_char(((b0 .&. 0x07) .<. 18) .|. ((b1 .&. 0x3F) .<. 12) .|. ((b2 .&. 0x3F) .<. 6) .|. (b3 .&. 0x3F))
                                       | key::ev_char(b0)
                                 | key::ev_char(b0)
                           | key::ev_char(b0)
                     | key::ev_char(b0)

   // Read and decode the next input event
   poll_event: Int => key::Event
   poll_event = timeout_ms =>
      b_opt = read_byte_opt(timeout_ms)
      b_opt
         | b0 =>
            b0
               [27] parse_escape_seq!
               [10, 13] key::ev_code(key::KEY_ENTER)
               [9] key::ev_code(key::KEY_TAB)
               [127] key::ev_code(key::KEY_BACKSPACE)
               [0] key::ev_ctrl('2')
               [28] key::ev_ctrl('4')
               [29] key::ev_ctrl('5')
               [30] key::ev_ctrl('6')
               [31] key::ev_ctrl('7')
               [(_ !< 1 && _ !> 26)] key::ev_ctrl(b0 + 96)
               [> 127] decode_utf8_char(b0)
               | key::ev_char(b0)
         | key::ev_none!

   // Query terminal color scheme via CSI ? 996 n + OSC 11; returns (scheme, bg_rgb)
   detect_theme: Int => (Int, Int)
   detect_theme = timeout_ms =>
      raw::query_theme!
      scheme' = key::THEME_UNKNOWN
      bg' = style::COLOR_DEFAULT
      ev1 = poll_event(timeout_ms)
      ev1.kind == key::EV_THEME |
         scheme' = ev1.code
         ev1.ch != style::COLOR_DEFAULT
            | bg' = ev1.ch
            |
               ev2 = poll_event(15)
               ev2.kind == key::EV_THEME && ev2.ch != style::COLOR_DEFAULT |
                  bg' = ev2.ch
      (scheme', bg')
