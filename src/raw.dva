// term/src/raw.dva — POSIX tty raw mode, terminal dimensions, and ANSI modes

#use libc
#use str

#public
   // Escape character (ASCII 27)
   ESC = "\e"
   esc: () => String
   esc = !=> "\e"

   // Write string directly to stdout
   write_raw: String => ()
   write_raw = s =>
      libc::write(1, s, ?s)

   // Query terminal rows and columns via TIOCGWINSZ ioctl (0x5413)
   get_size: () => (Int, Int)
   get_size = !=>
      buf = {8}
      p = &buf
      res = libc::ioctl(1, 0x5413, Int(p))
      res != 0
         | (24, 80)
         |
            row = Int(@[p u16])
            col = Int(@[p + 2 u16])
            r = row < 1 | 24 | row
            c = col < 1 | 80 | col
            (r, c)

   // Capture initial canonical termios and construct raw termios
   init_termios: Addr, Addr => <>
   init_termios = orig, raw =>
      libc::tcgetattr(0, orig) != 0 |->
      libc::memcpy(raw, orig, 64)
      libc::cfmakeraw(raw)
      <+>

   // Apply raw mode to stdin
   set_raw_termios: Addr => <>
   set_raw_termios = raw =>
      libc::tcsetattr(0, 0, raw) == 0

   // Enable raw mode on stdin (for backwards compatibility)
   enable_raw_termios: Addr, Addr => <>
   enable_raw_termios = orig, raw =>
      set_raw_termios(raw)

   // Restore canonical mode on stdin
   disable_raw_termios: Addr => <>
   disable_raw_termios = orig =>
      libc::tcsetattr(0, 2, orig) == 0

   // Alternate screen buffer, progressive keyboard enhancement & theme notifications
   enter_alt_screen: () => ()
   enter_alt_screen = !=>
      write_raw("\e[?1049h\e[?25l\e[>4;2m\e[>1u\e[?2031h") // enter alt screen, hide cursor, enable extended keys & theme notify

   exit_alt_screen: () => ()
   exit_alt_screen = !=>
      write_raw("\e[?2031l\e[>4;0m\e[<u\e[?25h\e[?1049l\e[0m") // disable theme notify & extended keys, show cursor, exit alt screen, reset SGR

   // Cursor visibility
   hide_cursor: () => ()
   hide_cursor = !=>
      write_raw("\e[?25l")

   show_cursor: () => ()
   show_cursor = !=>
      write_raw("\e[?25h")

   // Clear screen
   clear_screen: () => ()
   clear_screen = !=>
      write_raw("\e[2J\e[H")

   // Move cursor to (row, col) (1-indexed)
   move_cursor: Int, Int => ()
   move_cursor = r, c =>
      write_raw("\e[" + str::from_int(r) + ";" + str::from_int(c) + "H")

   // Mouse tracking (SGR 1006 extended mode + button/drag tracking 1000/1002)
   enable_mouse: () => ()
   enable_mouse = !=>
      write_raw("\e[?1000h\e[?1002h\e[?1006h")

   disable_mouse: () => ()
   disable_mouse = !=>
      write_raw("\e[?1006l\e[?1002l\e[?1000l")

   // Bracketed paste mode
   enable_bracketed_paste: () => ()
   enable_bracketed_paste = !=>
      write_raw("\e[?2004h")

   disable_bracketed_paste: () => ()
   disable_bracketed_paste = !=>
      write_raw("\e[?2004l")

   // Color scheme preference notifications (DEC Mode 2031) & queries (CSI ?996n + OSC 11)
   enable_theme_notify: () => ()
   enable_theme_notify = !=>
      write_raw("\e[?2031h")

   disable_theme_notify: () => ()
   disable_theme_notify = !=>
      write_raw("\e[?2031l")

   query_theme: () => ()
   query_theme = !=>
      write_raw("\e[?996n\e]11;?\e\\")

   // Hardware cursor shape (DECSCUSR)
   CURSOR_DEFAULT          = 0
   CURSOR_BLOCK            = 1 // blinking block
   CURSOR_BLOCK_STEADY     = 2 // steady block
   CURSOR_UNDERLINE        = 3 // blinking underline
   CURSOR_UNDERLINE_STEADY = 4 // steady underline
   CURSOR_BEAM             = 5 // blinking beam
   CURSOR_BEAM_STEADY      = 6 // steady beam

   set_cursor_shape: Int => ()
   set_cursor_shape = shape =>
      write_raw("\e[" + str::from_int(shape) + " q")

   // Synchronized output (atomic frame updates: Mode 2026)
   begin_sync: () => ()
   begin_sync = !=>
      write_raw("\e[?2026h")

   end_sync: () => ()
   end_sync = !=>
      write_raw("\e[?2026l")

   // Terminal window/tab title (OSC 0)
   set_title: String => ()
   set_title = title =>
      write_raw("\e]0;" + title + "\a")

   // Copy text to system clipboard via OSC 52
   copy_to_clipboard: String => ()
   copy_to_clipboard = text =>
      b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
      n = ?text
      n == 0 | --|
      out = {((n + 2) / 3) * 4 + 16}
      out += "\e]52;c;"
      i' = 0
      n / 3 @ chunk_idx =>
         b0 = text(i')
         b1 = text(i' + 1)
         b2 = text(i' + 2)
         i' = i' + 3
         out += b64(b0 .>. 2)
         out += b64(((b0 .&. 3) .<. 4) .|. (b1 .>. 4))
         out += b64(((b1 .&. 15) .<. 2) .|. (b2 .>. 6))
         out += b64(b2 .&. 63)
      rem = n - i'
      rem == 1 |
         b0 = text(i')
         out += b64(b0 .>. 2)
         out += b64((b0 .&. 3) .<. 4)
         out += '='
         out += '='
      rem == 2 |
         b0 = text(i')
         b1 = text(i' + 1)
         out += b64(b0 .>. 2)
         out += b64(((b0 .&. 3) .<. 4) .|. (b1 .>. 4))
         out += b64((b1 .&. 15) .<. 2)
         out += '='
      out += "\a"
      write_raw(+out)
