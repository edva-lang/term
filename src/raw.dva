// term/src/raw.dva — POSIX tty raw mode, terminal dimensions, and ANSI modes

#use libc
#use str

#public
   // Escape character (ASCII 27)
   ESC = "\e"
   esc: () => String
   esc = !=> "\e"

   // Write string directly to stdout
   write_raw: String => ()
   write_raw = s =>
      libc::write(1, s, ?s)

   // Query terminal rows and columns via TIOCGWINSZ ioctl (0x5413)
   get_size: () => (Int, Int)
   get_size = !=>
      buf = {8}
      p = &buf
      res = libc::ioctl(1, 0x5413, Int(p))
      res != 0
         | (24, 80)
         |
            row = Int(@[p u16])
            col = Int(@[p + 2 u16])
            r = row < 1 | 24 | row
            c = col < 1 | 80 | col
            (r, c)

   // Enable raw mode on stdin
   enable_raw_termios: Addr, Addr => <>
   enable_raw_termios = orig, raw =>
      libc::tcgetattr(0, orig) != 0 |->
      libc::memcpy(raw, orig, 64)
      libc::cfmakeraw(raw)
      libc::tcsetattr(0, 0, raw) == 0

   // Restore canonical mode on stdin
   disable_raw_termios: Addr => <>
   disable_raw_termios = orig =>
      libc::tcsetattr(0, 2, orig) == 0

   // Alternate screen buffer
   enter_alt_screen: () => ()
   enter_alt_screen = !=>
      write_raw("\e[?1049h\e[?25l") // enter alt screen, hide cursor

   exit_alt_screen: () => ()
   exit_alt_screen = !=>
      write_raw("\e[?25h\e[?1049l") // show cursor, exit alt screen

   // Cursor visibility
   hide_cursor: () => ()
   hide_cursor = !=>
      write_raw("\e[?25l")

   show_cursor: () => ()
   show_cursor = !=>
      write_raw("\e[?25h")

   // Clear screen
   clear_screen: () => ()
   clear_screen = !=>
      write_raw("\e[2J\e[H")

   // Move cursor to (row, col) (1-indexed)
   move_cursor: Int, Int => ()
   move_cursor = r, c =>
      write_raw("\e[" + str::from_int(r) + ";" + str::from_int(c) + "H")

   // Mouse tracking (SGR 1006 extended mode + button/drag tracking 1000/1002)
   enable_mouse: () => ()
   enable_mouse = !=>
      write_raw("\e[?1000h\e[?1002h\e[?1006h")

   disable_mouse: () => ()
   disable_mouse = !=>
      write_raw("\e[?1006l\e[?1002l\e[?1000l")

   // Bracketed paste mode
   enable_bracketed_paste: () => ()
   enable_bracketed_paste = !=>
      write_raw("\e[?2004h")

   disable_bracketed_paste: () => ()
   disable_bracketed_paste = !=>
      write_raw("\e[?2004l")
