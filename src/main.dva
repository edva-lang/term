// term/src/main.dva — Rich interactive demonstration of term features

#use io
#use term
#use str
#use utf

get_palette: Int => (term::Palette, String)
get_palette = idx =>
   (idx % 10)
      [0] (term::CATPPUCCIN, "Catppuccin")
      [1] (term::MONOKAI, "Monokai")
      [2] (term::NORD, "Nord")
      [3] (term::TOKYONIGHT, "Tokyo Night")
      [4] (term::SOLARIZED_DARK, "Solarized Dark")
      [5] (term::GRUVBOX_DARK, "Gruvbox Dark")
      [6] (term::ONE_DARK, "One Dark")
      [7] (term::DRACULA, "Dracula")
      [8] (term::ROSE_PINE, "Rose Pine")
      | (term::SOLARIZED_LIGHT, "Solarized Light")

get_cursor_shape_info: Int => (Int, String)
get_cursor_shape_info = idx =>
   (idx % 4)
      [0] (term::CURSOR_BLOCK, "Block (Blink)")
      [1] (term::CURSOR_BLOCK_STEADY, "Block (Steady)")
      [2] (term::CURSOR_BEAM, "Beam (Insert)")
      | (term::CURSOR_UNDERLINE, "Underline")

PAD_R = 4
PAD_C = 3
PAD_H = 10
PAD_W = 26

PAD_MIN_R = 5
PAD_MAX_R = 12
PAD_MIN_C = 4
PAD_MAX_C = 27

t = term::init!
term::enable_raw(t)
term::enable_mouse(t)
term::show_cursor(t)

cursor_r' = 6
cursor_c' = 8
mouse_x' = 0
mouse_y' = 0
tick' = 0
pal_idx' = term::is_dark(t) | 0 | 9
cur_shape_idx' = 0
last_input_str' = ++"None"
last_input_cp' = 0
mouse_msg' = ++"Mouse: None"

draw_ui: term::Term, Int, Int, String, String, Int, Int, Int, String, Int => ()
draw_ui = tm, cur_r, cur_c, stat_msg, m_msg, phase, pal_i, shape_i, in_str, in_cp =>
   term::clear(tm)
   r = tm.rows
   c = tm.cols

   pal_info = get_palette(pal_i)
   pal = pal_info.0
   pal_name = pal_info.1

   shape_info = get_cursor_shape_info(shape_i)
   cur_shape = shape_info.0
   shape_name = shape_info.1
   term::set_cursor_shape(tm, cur_shape)

   // Outer window box themed by active palette
   term::draw_titled_box(tm, 0, 0, r, c, term::BORDER_ROUNDED, "", pal.border, pal.bg, pal.fg)

   // Title & Palette Name + Detected Terminal Scheme
   scheme_label = term::is_dark(tm) | "Dark" | "Light"
   title = " term v1.2.0 — Theme: [" + pal_name + "] (Term: " + scheme_label + ") "
   term::put_str(tm, 0, 3, title, pal.blue, pal.bg, term::ATTR_BOLD)
   term::set_title(tm, "term — " + pal_name)

   // Header row: coordinates & shortcuts
   coord = "Cursor: (" + str::from_int(cur_r) + ", " + str::from_int(cur_c) + ") | Screen: " + str::from_int(r) + "x" + str::from_int(c)
   term::put_str(tm, 2, 3, coord, pal.yellow, pal.bg, 0)
   c > 65 |
      term::put_str(tm, 2, c - 45, "[p] Switch Theme  [c] Cursor Shape", pal.cyan, pal.bg, term::ATTR_BOLD)

   // Left Panel: Interactive Mouse & Cursor Pad (rows 4..13, width 26)
   term::draw_titled_box(tm, PAD_R, PAD_C, PAD_H, PAD_W, term::BORDER_SINGLE, "Cursor Pad", pal.border, pal.bg, pal.fg)
   term::put_str(tm, 5, 5, "Arrows/hjkl : Move", pal.muted, pal.bg, 0)
   term::put_str(tm, 6, 5, "Click/Drag  : Jump", pal.muted, pal.bg, 0)
   term::put_str(tm, 7, 5, "Wheel Up/Dn : Step", pal.muted, pal.bg, 0)
   term::put_str(tm, 8, 5, "Shape: " + shape_name, pal.green, pal.bg, 0)
   term::put_str(tm, 10, 5, "Press 'q' to exit", pal.red, pal.bg, term::ATTR_BOLD)

   // Middle/Right Panel: Palette Preview & Subgrid Window Viewport (rows 4..13)
   c > 33 |
      rp_w = c - 34
      rp_w > 12 |
         // Subgrid Window demonstrating local coordinates & boundary clipping
         win_h = 10
         win_w = rp_w < 44 | rp_w | 44
         win = term::create_window(tm, 4, 31, win_h, win_w)
         grid::win_titled_box(win, 0, 0, win_h, win_w, term::BORDER_ROUNDED, "Subgrid Viewport (" + pal_name + ")", pal.purple, pal.bg, pal.fg)

         // Palette swatches inside the subgrid window
         grid::win_put_str(win, 2, 2, "Neutrals:", pal.fg, pal.bg, term::ATTR_BOLD)
         grid::win_fill_rect(win, 3, 2, 1, 5, 0x2588, pal.bg, pal.surface, 0)
         grid::win_fill_rect(win, 3, 8, 1, 5, 0x2588, pal.surface, pal.bg, 0)
         grid::win_fill_rect(win, 3, 14, 1, 5, 0x2588, pal.border, pal.bg, 0)
         grid::win_fill_rect(win, 3, 20, 1, 5, 0x2588, pal.muted, pal.bg, 0)
         grid::win_fill_rect(win, 3, 26, 1, 5, 0x2588, pal.fg, pal.bg, 0)

         grid::win_put_str(win, 5, 2, "Accents:", pal.fg, pal.bg, term::ATTR_BOLD)
         grid::win_fill_rect(win, 6, 2, 1, 4, 0x2588, pal.red, pal.bg, 0)
         grid::win_fill_rect(win, 6, 7, 1, 4, 0x2588, pal.orange, pal.bg, 0)
         grid::win_fill_rect(win, 6, 12, 1, 4, 0x2588, pal.yellow, pal.bg, 0)
         grid::win_fill_rect(win, 6, 17, 1, 4, 0x2588, pal.green, pal.bg, 0)
         grid::win_fill_rect(win, 6, 22, 1, 4, 0x2588, pal.cyan, pal.bg, 0)
         grid::win_fill_rect(win, 6, 27, 1, 4, 0x2588, pal.blue, pal.bg, 0)
         grid::win_fill_rect(win, 6, 32, 1, 4, 0x2588, pal.purple, pal.bg, 0)

         // Color blend demonstration
         blend_demo = "Blend Red->Blue: "
         grid::win_put_str(win, 8, 2, blend_demo, pal.muted, pal.bg, 0)
         16 @ bi =>
            b_col = term::blend(pal.red, pal.blue, (bi * 100) / 15)
            grid::win_set(win, 8, 19 + bi, 0x2588, b_col, pal.bg, 0)

   // Lower Panel: Multi-byte UTF-8 Input Tester (rows 15..19)
   r > 19 |
      term::draw_titled_box(tm, 15, 3, 5, c - 6, term::BORDER_SINGLE, "Live Multi-byte UTF-8 Stdin Tester", pal.border, pal.bg, pal.fg)
      term::put_str(tm, 16, 5, "Type any key or multi-byte UTF-8 character (e.g. Cyrillic, Greek, Emojis):", pal.fg, pal.bg, 0)
      in_info = "Last Received: '" + in_str + "'  (Codepoint Dec: " + str::from_int(in_cp) + ", UTF-8 Width: " + str::from_int(?Rune(in_cp)) + "B)"
      term::put_str(tm, 17, 5, in_info, pal.green, pal.bg, term::ATTR_BOLD)

   // Status bar at bottom
   term::put_str(tm, r - 3, 2, m_msg, pal.cyan, pal.bg, 0)
   term::put_str(tm, r - 2, 2, stat_msg, pal.muted, pal.bg, 0)

   // Render back buffer with synchronized atomic frame update
   term::render(tm)

   // Position hardware cursor at the active pad position
   term::set_cursor(tm, cur_r, cur_c)

status_msg' = ++"Controls: [q] Exit  [p] Cycle Theme  [c] Cycle Cursor  [Arrows/hjkl/Mouse] Move Cursor"
draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')

0.. @
   ev = term::poll_event(t, 50)
   ev.kind == term::EV_NONE |
      tick' = (tick' + 1) % 1536

   ev.kind == term::EV_KEY |
      ev.code == term::KEY_CHAR |
         ev.ch == 'q' | -->
         ev.ch == 'p' |
            pal_idx' = pal_idx' + 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         ev.ch == 'c' |
            cur_shape_idx' = cur_shape_idx' + 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         ev.ch == 'h' && cursor_c' > PAD_MIN_C |
            cursor_c' = cursor_c' - 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         ev.ch == 'l' && cursor_c' < PAD_MAX_C |
            cursor_c' = cursor_c' + 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         ev.ch == 'k' && cursor_r' > PAD_MIN_R |
            cursor_r' = cursor_r' - 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         ev.ch == 'j' && cursor_r' < PAD_MAX_R |
            cursor_r' = cursor_r' + 1
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
         |
            // Other character typed: record for live UTF-8 tester
            last_input_cp' = ev.ch
            last_input_str' = ++utf::encode_codepoint(ev.ch)
            draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')

      ev.code == term::KEY_UP && cursor_r' > PAD_MIN_R |
         cursor_r' = cursor_r' - 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
      ev.code == term::KEY_DOWN && cursor_r' < PAD_MAX_R |
         cursor_r' = cursor_r' + 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
      ev.code == term::KEY_LEFT && cursor_c' > PAD_MIN_C |
         cursor_c' = cursor_c' - 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
      ev.code == term::KEY_RIGHT && cursor_c' < PAD_MAX_C |
         cursor_c' = cursor_c' + 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')
      ev.code == term::KEY_ESC | -->

   ev.kind == term::EV_MOUSE |
      mx = ev.x - 1
      my = ev.y - 1
      ev.mouse_act == term::MOUSE_PRESS |
         mouse_msg' = ++("Mouse Pressed: Button " + str::from_int(ev.mouse_btn) + " at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         my !< PAD_R && my !> (PAD_R + PAD_H - 1) && mx !< PAD_C && mx !> (PAD_C + PAD_W - 1) |
            target_r = my < PAD_MIN_R | PAD_MIN_R | (my > PAD_MAX_R | PAD_MAX_R | my)
            target_c = mx < PAD_MIN_C | PAD_MIN_C | (mx > PAD_MAX_C | PAD_MAX_C | mx)
            cursor_r' = target_r
            cursor_c' = target_c
      ev.mouse_act == term::MOUSE_DRAG |
         mouse_msg' = ++("Mouse Dragged to (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         my !< PAD_R && my !> (PAD_R + PAD_H - 1) && mx !< PAD_C && mx !> (PAD_C + PAD_W - 1) |
            target_r = my < PAD_MIN_R | PAD_MIN_R | (my > PAD_MAX_R | PAD_MAX_R | my)
            target_c = mx < PAD_MIN_C | PAD_MIN_C | (mx > PAD_MAX_C | PAD_MAX_C | mx)
            cursor_r' = target_r
            cursor_c' = target_c
      ev.mouse_act == term::MOUSE_RELEASE |
         mouse_msg' = ++("Mouse Released at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
      ev.mouse_act == term::MOUSE_SCROLL_UP |
         mouse_msg' = ++("Mouse Wheel UP at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         cursor_r' > PAD_MIN_R | cursor_r' = cursor_r' - 1
      ev.mouse_act == term::MOUSE_SCROLL_DOWN |
         mouse_msg' = ++("Mouse Wheel DOWN at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         cursor_r' < PAD_MAX_R | cursor_r' = cursor_r' + 1
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')

   ev.kind == term::EV_RESIZE |
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')

   ev.kind == term::EV_THEME |
      pal_idx' = term::is_dark(t) | 0 | 9
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick', pal_idx', cur_shape_idx', last_input_str', last_input_cp')

term::disable_mouse(t)
term::disable_raw(t)
term::shutdown(t)
io::out("Term demo exited cleanly.\n")
