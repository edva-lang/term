// term/src/main.dva — Rich interactive demonstration of term features

#use io
#use term
#use str

lerp_ch: Int, Int, Int, Int => Int
lerp_ch = a, b, step, total =>
   tot = total < 1 | 1 | total
   a + ((b - a) * step) / tot

lerp_rgb: Int, Int, Int, Int => Int
lerp_rgb = c1, c2, step, total =>
   r1 = (c1 .>. 16) .&. 255
   g1 = (c1 .>. 8) .&. 255
   b1 = c1 .&. 255
   r2 = (c2 .>. 16) .&. 255
   g2 = (c2 .>. 8) .&. 255
   b2 = c2 .&. 255
   term::rgb(lerp_ch(r1, r2, step, total), lerp_ch(g1, g2, step, total), lerp_ch(b1, b2, step, total))

hue_rgb: Int => Int
hue_rgb = h =>
   h_norm = ((h % 1536) + 1536) % 1536
   seg = h_norm / 256
   pos = h_norm % 256
   seg
      [0] term::rgb(255, pos, 0)
      [1] term::rgb(255 - pos, 255, 0)
      [2] term::rgb(0, 255, pos)
      [3] term::rgb(0, 255 - pos, 255)
      [4] term::rgb(pos, 0, 255)
      | term::rgb(255, 0, 255 - pos)

sunset_stop: Int => Int
sunset_stop = idx =>
   idx
      [0] 0x2c003e
      [1] 0x6e0e64
      [2] 0xb01962
      [3] 0xe03b41
      [4] 0xf06b24
      [5] 0xf6ad29
      |   0xffe072

aurora_stop: Int => Int
aurora_stop = idx =>
   idx
      [0] 0x040d21
      [1] 0x082e54
      [2] 0x0e637a
      [3] 0x149a80
      [4] 0x2ec686
      [5] 0x76f07c
      |   0xcbffa8

cyber_stop: Int => Int
cyber_stop = idx =>
   idx
      [0] 0x28023d
      [1] 0x5a095a
      [2] 0x9e0b74
      [3] 0xe80a89
      [4] 0xff4f79
      [5] 0xff9248
      |   0x00f5d4

lerp_stops: (Int => Int), Int, Int, Int => Int
lerp_stops = stop_fn, num_stops, step, total =>
   tot = total < 1 | 1 | total
   num_segs = num_stops - 1
   scaled = (step * num_segs * 1000) / tot
   seg = scaled / 1000
   seg_idx = seg !< num_segs | num_segs - 1 | seg
   rem = scaled - seg_idx * 1000
   c1 = stop_fn(seg_idx)
   c2 = stop_fn(seg_idx + 1)
   lerp_rgb(c1, c2, rem, 1000)

put_gradient_str: term::Term, Int, Int, String, Int, Int, Int => ()
put_gradient_str = tm, r, c, text, c1, c2, attr =>
   tot = ??text
   tot < 1 | --|
   idx' = 0
   text @@ ch =>
      fg = lerp_rgb(c1, c2, idx', tot - 1)
      term::set_cell(tm, r, c + idx', Int(ch), fg, -1, attr)
      idx' = idx' + 1

put_rainbow_str: term::Term, Int, Int, String, Int, Int => ()
put_rainbow_str = tm, r, c, text, phase, attr =>
   tot = ??text
   tot < 1 | --|
   idx' = 0
   text @@ ch =>
      fg = hue_rgb(phase + (idx' * 1536) / tot)
      term::set_cell(tm, r, c + idx', Int(ch), fg, -1, attr)
      idx' = idx' + 1

ansi_color: Int => Int
ansi_color = idx =>
   idx
      [0]  0x000000
      [1]  0xcd3131
      [2]  0x0dbc79
      [3]  0xe5e510
      [4]  0x2472c8
      [5]  0xbc3fbc
      [6]  0x11a8cd
      [7]  0xe5e5e5
      [8]  0x666666
      [9]  0xf14c4c
      [10] 0x23d18b
      [11] 0xf5f543
      [12] 0x3b8eea
      [13] 0xd670d6
      [14] 0x29b8db
      | 0xffffff

ansi_name: Int => String
ansi_name = idx =>
   idx
      [0]  "Blk"
      [1]  "Red"
      [2]  "Grn"
      [3]  "Yel"
      [4]  "Blu"
      [5]  "Mag"
      [6]  "Cya"
      [7]  "Whi"
      [8]  "BBlk"
      [9]  "BRed"
      [10] "BGrn"
      [11] "BYel"
      [12] "BBlu"
      [13] "BMag"
      [14] "BCya"
      | "BWhi"

PAD_R = 4
PAD_C = 3
PAD_H = 10
PAD_W = 26

PAD_MIN_R = 5
PAD_MAX_R = 12
PAD_MIN_C = 4
PAD_MAX_C = 27

t = term::init!
term::enable_raw(t)
term::enable_mouse(t)

cursor_r' = 6
cursor_c' = 8
mouse_x' = 0
mouse_y' = 0
tick' = 0
mouse_msg' = ++"Mouse: None"
status_msg' = ++"Use Arrows/hjkl, Mouse Click/Drag/Scroll, or 'q' to exit"

draw_ui: term::Term, Int, Int, String, String, Int => ()
draw_ui = tm, cur_r, cur_c, stat_msg, m_msg, phase =>
   term::clear(tm)
   r = tm.rows
   c = tm.cols

   // Outer window box with rounded corners
   term::draw_titled_box(tm, 0, 0, r, c, term::BORDER_ROUNDED, "", 0x585b70, -1, 0xcdd6f4)

   // Title with per-character smooth gradient across every letter
   c > 45 |
      put_gradient_str(tm, 0, 3, " term v0.1.0 — 24-bit TrueColor Diff Engine ", 0xf9e2af, 0x89dceb, term::ATTR_BOLD)

   // Header row
   coord = "Cursor: (" + str::from_int(cur_r) + ", " + str::from_int(cur_c) + ") | Screen: " + str::from_int(r) + "x" + str::from_int(c)
   term::put_str(tm, 2, 3, coord, 0xfab387, -1, 0)
   c > 50 |
      put_gradient_str(tm, 2, c - 34, "Smooth Micro-Step Gradients", 0xa6e3a1, 0x89b4fa, term::ATTR_BOLD)

   // Left Panel: Interactive Mouse Test Pad (rows 4..13, width 26)
   term::draw_titled_box(tm, PAD_R, PAD_C, PAD_H, PAD_W, term::BORDER_SINGLE, "Mouse Test Pad", 0x585b70, -1, 0xcdd6f4)
   term::put_str(tm, 5, 5, "Arrows/hjkl : Move *", 0xa6adc8, -1, 0)
   term::put_str(tm, 6, 5, "Click/Drag  : Jump", 0xa6adc8, -1, 0)
   term::put_str(tm, 7, 5, "Scroll Wheel: Up/Dn", 0xa6adc8, -1, 0)
   term::put_str(tm, 9, 5, "Press 'q'   : Exit", 0xf38ba8, -1, term::ATTR_BOLD)

   // Active cursor marker inside pad
   term::set_cell(tm, cur_r, cur_c, '*', 0xf38ba8, 0x313244, term::ATTR_BOLD)

   // Right Panel: 24-bit TrueColor spectrum and gradients (rows 4..13)
   c > 33 |
      rp_w = c - 34
      term::draw_titled_box(tm, 4, 31, 10, rp_w, term::BORDER_SINGLE, "TrueColor Gradients", 0x585b70, -1, 0xcdd6f4)
      spec_w = rp_w - 4
      spec_w > 8 |
         // Row 5 & 6: Continuous Hue Wave where EVERY character changes color
         term::put_str(tm, 5, 33, "Continuous Hue Wave:", 0xcba6f7, -1, 0)
         spec_w @ x =>
            col_rgb = hue_rgb(phase * 4 + (x * 1536) / spec_w)
            term::set_cell(tm, 6, 33 + x, 0x2588, col_rgb, -1, 0)

         // Row 7 & 8: Multi-stop Sunset and Aurora Gradients
         term::put_str(tm, 7, 33, "Sunset & Aurora Horizons:", 0xfab387, -1, 0)
         half = spec_w / 2
         half @ x =>
            s_col = lerp_stops(sunset_stop, 7, x, half)
            a_col = lerp_stops(aurora_stop, 7, x, half)
            term::set_cell(tm, 8, 33 + x, 0x2588, s_col, -1, 0)
            term::set_cell(tm, 8, 33 + half + x, 0x2588, a_col, -1, 0)

         // Row 9 & 10: Per-character text gradient strings
         term::put_str(tm, 9, 33, "Per-Character Text Gradient:", 0x89dceb, -1, 0)
         put_gradient_str(tm, 10, 33, "✦ Every single glyph changes color ever so slightly ✦", 0xf38ba8, 0x89dceb, term::ATTR_BOLD)

         // Row 11: Rainbow flowing text
         put_rainbow_str(tm, 11, 33, "Smooth continuous spectrum across UTF-8 text strings", phase * 3, 0)

         // Row 12: Inverted gradient background with crisp foreground text
         bg_w = spec_w < 42 | spec_w | 42
         bg_txt = "  TrueColor 24-bit Micro-Step Engine  "
         bg_len = ??bg_txt
         idx_b' = 0
         bg_txt @@ ch =>
            bg_col = lerp_stops(cyber_stop, 7, idx_b', bg_len)
            term::set_cell(tm, 12, 33 + idx_b', Int(ch), 0x11111b, bg_col, term::ATTR_BOLD)
            idx_b' = idx_b' + 1

   // Bottom Panel: Standard 16 ANSI Palette and Text Attributes (rows 15..r-4)
   r > 19 |
      term::put_str(tm, 14, 3, "Standard 16 ANSI Palette:", 0xcdd6f4, -1, term::ATTR_BOLD)
      8 @ a =>
         col_x = 3 + a * 9
         col_x + 8 < c |
            term::put_str(tm, 15, col_x, "██", ansi_color(a), -1, 0)
            term::put_str(tm, 15, col_x + 3, ansi_name(a), ansi_color(a), -1, 0)
            term::put_str(tm, 16, col_x, "██", ansi_color(a + 8), -1, 0)
            term::put_str(tm, 16, col_x + 3, ansi_name(a + 8), ansi_color(a + 8), -1, 0)

   r > 21 |
      term::put_str(tm, 18, 3, "Text Attributes:", 0xa6adc8, -1, 0)
      term::put_str(tm, 18, 20, "Normal", 0xcdd6f4, -1, term::ATTR_NONE)
      term::put_str(tm, 18, 28, "Bold", 0xf38ba8, -1, term::ATTR_BOLD)
      term::put_str(tm, 18, 34, "Dim", 0x6c7086, -1, term::ATTR_DIM)
      term::put_str(tm, 18, 39, "Italic", 0xfab387, -1, term::ATTR_ITALIC)
      term::put_str(tm, 18, 47, "Underline", 0xa6e3a1, -1, term::ATTR_UNDERLINE)
      term::put_str(tm, 18, 58, " Reverse ", 0x1e1e2e, 0x89b4fa, term::ATTR_NONE)

   // Status bar at bottom
   term::put_str(tm, r - 3, 2, m_msg, 0x94e2d5, -1, 0)
   term::put_str(tm, r - 2, 2, stat_msg, 0xa6adc8, -1, 0)

   term::render(tm)

draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')

0.. @
   ev = term::poll_event(t, 33)
   ev.kind == term::EV_NONE |
      tick' = (tick' + 2) % 1536
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')

   ev.kind == term::EV_KEY |
      ev.code == term::KEY_CHAR |
         ev.ch == 'q' | -->
         ev.ch == 'h' && cursor_c' > PAD_MIN_C | cursor_c' = cursor_c' - 1
         ev.ch == 'l' && cursor_c' < PAD_MAX_C | cursor_c' = cursor_c' + 1
         ev.ch == 'k' && cursor_r' > PAD_MIN_R | cursor_r' = cursor_r' - 1
         ev.ch == 'j' && cursor_r' < PAD_MAX_R | cursor_r' = cursor_r' + 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')
      ev.code == term::KEY_UP && cursor_r' > PAD_MIN_R |
         cursor_r' = cursor_r' - 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')
      ev.code == term::KEY_DOWN && cursor_r' < PAD_MAX_R |
         cursor_r' = cursor_r' + 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')
      ev.code == term::KEY_LEFT && cursor_c' > PAD_MIN_C |
         cursor_c' = cursor_c' - 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')
      ev.code == term::KEY_RIGHT && cursor_c' < PAD_MAX_C |
         cursor_c' = cursor_c' + 1
         draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')
      ev.code == term::KEY_ESC | -->

   ev.kind == term::EV_MOUSE |
      mouse_x' = ev.x
      mouse_y' = ev.y
      mx = ev.x - 1
      my = ev.y - 1
      ev.mouse_act == term::MOUSE_PRESS |
         mouse_msg' = ++("Mouse Pressed: Button " + str::from_int(ev.mouse_btn) + " at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         my !< PAD_R && my !> (PAD_R + PAD_H - 1) && mx !< PAD_C && mx !> (PAD_C + PAD_W - 1) |
            target_r = my < PAD_MIN_R | PAD_MIN_R | (my > PAD_MAX_R | PAD_MAX_R | my)
            target_c = mx < PAD_MIN_C | PAD_MIN_C | (mx > PAD_MAX_C | PAD_MAX_C | mx)
            cursor_r' = target_r
            cursor_c' = target_c
      ev.mouse_act == term::MOUSE_DRAG |
         mouse_msg' = ++("Mouse Dragged to (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         my !< PAD_R && my !> (PAD_R + PAD_H - 1) && mx !< PAD_C && mx !> (PAD_C + PAD_W - 1) |
            target_r = my < PAD_MIN_R | PAD_MIN_R | (my > PAD_MAX_R | PAD_MAX_R | my)
            target_c = mx < PAD_MIN_C | PAD_MIN_C | (mx > PAD_MAX_C | PAD_MAX_C | mx)
            cursor_r' = target_r
            cursor_c' = target_c
      ev.mouse_act == term::MOUSE_RELEASE |
         mouse_msg' = ++("Mouse Released at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
      ev.mouse_act == term::MOUSE_SCROLL_UP |
         mouse_msg' = ++("Mouse Wheel UP at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         cursor_r' > PAD_MIN_R | cursor_r' = cursor_r' - 1
      ev.mouse_act == term::MOUSE_SCROLL_DOWN |
         mouse_msg' = ++("Mouse Wheel DOWN at (" + str::from_int(ev.x) + ", " + str::from_int(ev.y) + ")")
         cursor_r' < PAD_MAX_R | cursor_r' = cursor_r' + 1
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')

   ev.kind == term::EV_RESIZE |
      draw_ui(t, cursor_r', cursor_c', status_msg', mouse_msg', tick')

term::disable_mouse(t)
term::disable_raw(t)
term::shutdown(t)
io::out("Term demo exited cleanly.\n")
