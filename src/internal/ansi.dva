// src/internal/ansi.dva — Low-level ANSI escape code generator
// Package-private internal module for 'term'

#public
   csi: String => String
   csi = code =>
      b = {?code + 4}
      b += (27, '[', code, 'm')
      +b

   wrap: String, String => String
   wrap = code, s =>
      b = {?code + ?s + 12}
      b += (27, '[', code, 'm', s, 27, '[', '0', 'm')
      +b
