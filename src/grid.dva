// term/src/grid.dva — Cell Grid Matrix, UTF-8 rune renderer, and Drawing Primitives

#use utf
#use str
#use "style"
#use "raw"

#public
   #type Cell: #packed (
      ch: u32,
      fg: i32,
      bg: i32,
      attr: u32
   )

   #type Grid (
      rows: Int,
      cols: Int,
      cells: (Cell){}
   )

   // Allocate a new grid of rows x cols
   new: Int, Int => Grid
   new = rows, cols =>
      r = rows < 1 | 1 | rows
      c = cols < 1 | 1 | cols
      cells = (Cell){}
      (r * c) @ i =>
         cells += Cell((32, -1, -1, 0))
      Grid((r, c, cells))

   // Allocate a sentinel grid where every cell is mismatched
   new_invalid: Int, Int => Grid
   new_invalid = rows, cols =>
      r = rows < 1 | 1 | rows
      c = cols < 1 | 1 | cols
      cells = (Cell){}
      (r * c) @ i =>
         cells += Cell((0, -999, -999, 999))
      Grid((r, c, cells))

   clear: Grid => ()
   clear = g =>
      total = g.rows * g.cols
      total @ i =>
         g.cells(i) = Cell((32, -1, -1, 0))

   set: Grid, Int, Int, Int, Int, Int, Int => ()
   set = g, row, col, ch, fg, bg, attr =>
      row < 0 || row !< g.rows || col < 0 || col !< g.cols | --|
      g.cells(row * g.cols + col) = Cell((u32(ch), i32(fg), i32(bg), u32(attr)))

   get: Grid, Int, Int => (Int, Int, Int, Int)
   get = g, row, col =>
      row < 0 || row !< g.rows || col < 0 || col !< g.cols | --| (32, -1, -1, 0)
      c = g.cells(row * g.cols + col)!!
      (Int(c.ch), Int(c.fg), Int(c.bg), Int(c.attr))

   // Fill rectangular region
   fill_rect: Grid, Int, Int, Int, Int, Int, Int, Int, Int => ()
   fill_rect = g, start_r, start_c, h, w, ch, fg, bg, attr =>
      h @ dr =>
         r = start_r + dr
         r !< g.rows | -->
         r !< 0 |
            w @ dc =>
               c = start_c + dc
               c !< g.cols | -->
               c !< 0 |
                  set(g, r, c, ch, fg, bg, attr)

   // Write string into grid
   put_str: Grid, Int, Int, String, Int, Int, Int => ()
   put_str = g, row, col, text, fg, bg, attr =>
      row < 0 || row !< g.rows | --|
      c' = col
      text @@ r =>
         c' !< g.cols | -->
         c' !< 0
            |
               set(g, row, c', Int(r), fg, bg, attr)
         c' = c' + 1

   // Write string clipped to maximum visible width
   put_str_clipped: Grid, Int, Int, String, Int, Int, Int, Int => ()
   put_str_clipped = g, row, col, text, max_w, fg, bg, attr =>
      row < 0 || row !< g.rows || max_w !> 0 | --|
      c' = col
      written' = 0
      text @@ r =>
         written' !< max_w || c' !< g.cols | -->
         c' !< 0
            |
               set(g, row, c', Int(r), fg, bg, attr)
         c' = c' + 1
         written' = written' + 1

   ALIGN_LEFT   = 0
   ALIGN_CENTER = 1
   ALIGN_RIGHT  = 2

   // Write string aligned within fixed width box
   put_str_aligned: Grid, Int, Int, String, Int, Int, Int, Int, Int => ()
   put_str_aligned = g, row, col, text, width, align, fg, bg, attr =>
      len = ??text
      start_col = align == ALIGN_CENTER
         | col + (width - len) / 2
         | align == ALIGN_RIGHT
            | col + (width - len)
            | col
      put_str_clipped(g, row, start_col, text, width, fg, bg, attr)

   // Draw horizontal line
   draw_hline: Grid, Int, Int, Int, Int, Int, Int, Int => ()
   draw_hline = g, row, start_c, len, ch, fg, bg, attr =>
      len @ dc =>
         set(g, row, start_c + dc, ch, fg, bg, attr)

   // Draw vertical line
   draw_vline: Grid, Int, Int, Int, Int, Int, Int, Int => ()
   draw_vline = g, start_r, col, len, ch, fg, bg, attr =>
      len @ dr =>
         set(g, start_r + dr, col, ch, fg, bg, attr)

   // Draw border box with optional title
   draw_box: Grid, Int, Int, Int, Int, Int, Int, Int => ()
   draw_box = g, r, c, h, w, border_style, fg, bg =>
      h < 2 || w < 2 | --|
      chars = style::border_chars(border_style)
      tl = chars(0)
      tr = chars(1)
      bl = chars(2)
      br = chars(3)
      horiz = chars(4)
      vert = chars(5)

      // Corners
      set(g, r, c, tl, fg, bg, 0)
      set(g, r, c + w - 1, tr, fg, bg, 0)
      set(g, r + h - 1, c, bl, fg, bg, 0)
      set(g, r + h - 1, c + w - 1, br, fg, bg, 0)

      // Top and bottom horizontal lines
      (w - 2) @ i =>
         set(g, r, c + 1 + i, horiz, fg, bg, 0)
         set(g, r + h - 1, c + 1 + i, horiz, fg, bg, 0)

      // Left and right vertical lines
      (h - 2) @ j =>
         set(g, r + 1 + j, c, vert, fg, bg, 0)
         set(g, r + 1 + j, c + w - 1, vert, fg, bg, 0)

   // Draw box with a title embedded in the top border
   draw_titled_box: Grid, Int, Int, Int, Int, Int, String, Int, Int, Int => ()
   draw_titled_box = g, r, c, h, w, border_style, title, fg, bg, title_fg =>
      draw_box(g, r, c, h, w, border_style, fg, bg)
      tlen = ??title
      tlen > 0 && w > tlen + 4 |
         put_str(g, r, c + 2, " " + title + " ", title_fg, bg, style::ATTR_BOLD)

   // Render diff between back and front buffer matrices
   render_diff: Grid, Grid, Int, Int => ()
   render_diff = front, back, rows, cols =>
      cur_fg' = -2
      cur_bg' = -2
      cur_attr' = -1
      cur_r' = -1
      cur_c' = -1

      out = {8192}

      rows @ r =>
         cols @ c =>
            off = r * cols + c
            fc = front.cells(off)!!
            bc = back.cells(off)!!

            // If cell changed, emit update
            fc.ch != bc.ch || fc.fg != bc.fg || fc.bg != bc.bg || fc.attr != bc.attr
               |
                  // Only move cursor if not already at (r, c)
                  r != cur_r' || c != cur_c'
                     |
                        out += "\e[" + str::from_int(r + 1) + ";" + str::from_int(c + 1) + "H"
                        cur_r' = r
                        cur_c' = c

                  b_at = Int(bc.attr)
                  b_fg = Int(bc.fg)
                  b_bg = Int(bc.bg)
                  b_ch = Int(bc.ch)

                  // Update attributes if changed
                  b_at != cur_attr'
                     |
                        out += "\e[0m" // reset
                        cur_fg' = -2
                        cur_bg' = -2
                        (b_at .&. style::ATTR_BOLD) != 0      | out += "\e[1m"
                        (b_at .&. style::ATTR_DIM) != 0       | out += "\e[2m"
                        (b_at .&. style::ATTR_ITALIC) != 0    | out += "\e[3m"
                        (b_at .&. style::ATTR_UNDERLINE) != 0 | out += "\e[4m"
                        (b_at .&. style::ATTR_REVERSE) != 0   | out += "\e[7m"
                        cur_attr' = b_at

                  // Update FG color if changed
                  b_fg != cur_fg'
                     |
                        b_fg == -1
                           | out += "\e[39m"
                           |
                              red = style::red(b_fg)
                              green = style::green(b_fg)
                              blue = style::blue(b_fg)
                              out += "\e[38;2;" + str::from_int(red) + ";" + str::from_int(green) + ";" + str::from_int(blue) + "m"
                        cur_fg' = b_fg

                  // Update BG color if changed
                  b_bg != cur_bg'
                     |
                        b_bg == -1
                           | out += "\e[49m"
                           |
                              red = style::red(b_bg)
                              green = style::green(b_bg)
                              blue = style::blue(b_bg)
                              out += "\e[48;2;" + str::from_int(red) + ";" + str::from_int(green) + ";" + str::from_int(blue) + "m"
                        cur_bg' = b_bg

                  // Emit character (multibyte UTF-8 aware)
                  utf::append_rune(out, Rune(b_ch))
                  cur_c' = cur_c' + 1

                  // Sync front cell with back cell
                  front.cells(off) = bc

      // Flush buffer to stdout with synchronized frame update
      ?out > 0
         |
            raw::begin_sync!
            raw::write_raw(+out)
            raw::end_sync!

   // --- Viewport / Subgrid Window Layout Primitives ---
   #type Window (
      grid: Grid,
      r: Int,
      c: Int,
      h: Int,
      w: Int
   )

   win_new: Grid, Int, Int, Int, Int => Window
   win_new = g, r, c, h, w =>
      Window((g, r, c, h, w))

   win_set: Window, Int, Int, Int, Int, Int, Int => ()
   win_set = win, wr, wc, ch, fg, bg, attr =>
      wr < 0 || wr !< win.h || wc < 0 || wc !< win.w | --|
      set(win.grid, win.r + wr, win.c + wc, ch, fg, bg, attr)

   win_fill_rect: Window, Int, Int, Int, Int, Int, Int, Int, Int => ()
   win_fill_rect = win, wr, wc, h, w, ch, fg, bg, attr =>
      h @ dr =>
         w @ dc =>
            win_set(win, wr + dr, wc + dc, ch, fg, bg, attr)

   win_put_str: Window, Int, Int, String, Int, Int, Int => ()
   win_put_str = win, wr, wc, text, fg, bg, attr =>
      wr < 0 || wr !< win.h | --|
      avail = win.w - wc
      avail !> 0 | --|
      put_str_clipped(win.grid, win.r + wr, win.c + wc, text, avail, fg, bg, attr)

   win_box: Window, Int, Int, Int, Int, Int, Int, Int => ()
   win_box = win, wr, wc, h, w, style, fg, bg =>
      chars = style::border_chars(style)
      tl = chars(0)
      tr = chars(1)
      bl = chars(2)
      br = chars(3)
      hz = chars(4)
      vt = chars(5)
      win_set(win, wr, wc, tl, fg, bg, 0)
      win_set(win, wr, wc + w - 1, tr, fg, bg, 0)
      win_set(win, wr + h - 1, wc, bl, fg, bg, 0)
      win_set(win, wr + h - 1, wc + w - 1, br, fg, bg, 0)
      (w - 2) @ col =>
         win_set(win, wr, wc + 1 + col, hz, fg, bg, 0)
         win_set(win, wr + h - 1, wc + 1 + col, hz, fg, bg, 0)
      (h - 2) @ row =>
         win_set(win, wr + 1 + row, wc, vt, fg, bg, 0)
         win_set(win, wr + 1 + row, wc + w - 1, vt, fg, bg, 0)

   win_titled_box: Window, Int, Int, Int, Int, Int, String, Int, Int, Int => ()
   win_titled_box = win, wr, wc, h, w, style, title, fg, bg, title_fg =>
      win_box(win, wr, wc, h, w, style, fg, bg)
      t_len = ?title
      t_len > 0 && w > 4 |
         avail = w - 4
         avail !< t_len |
            win_put_str(win, wr, wc + 2, " " + title + " ", title_fg, bg, style::ATTR_BOLD)
