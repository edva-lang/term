// term/src/term.dva — High-performance, zero-flicker Edva terminal library

#use str
#use "key"
#use "style"
#use "raw"
#use "grid"
#use "input"

#public
   // --- Re-exports from submodules ---
   // Key codes
   KEY_NONE       = key::KEY_NONE
   KEY_CHAR       = key::KEY_CHAR
   KEY_UP         = key::KEY_UP
   KEY_DOWN       = key::KEY_DOWN
   KEY_LEFT       = key::KEY_LEFT
   KEY_RIGHT      = key::KEY_RIGHT
   KEY_HOME       = key::KEY_HOME
   KEY_END        = key::KEY_END
   KEY_PAGE_UP    = key::KEY_PAGE_UP
   KEY_PAGE_DOWN  = key::KEY_PAGE_DOWN
   KEY_BACKSPACE  = key::KEY_BACKSPACE
   KEY_DELETE     = key::KEY_DELETE
   KEY_ENTER      = key::KEY_ENTER
   KEY_TAB        = key::KEY_TAB
   KEY_BACKTAB    = key::KEY_BACKTAB
   KEY_ESC        = key::KEY_ESC
   KEY_CTRL       = key::KEY_CTRL
   KEY_ALT        = key::KEY_ALT
   KEY_INSERT     = key::KEY_INSERT
   KEY_F1         = key::KEY_F1
   KEY_F2         = key::KEY_F2
   KEY_F3         = key::KEY_F3
   KEY_F4         = key::KEY_F4
   KEY_F5         = key::KEY_F5
   KEY_F6         = key::KEY_F6
   KEY_F7         = key::KEY_F7
   KEY_F8         = key::KEY_F8
   KEY_F9         = key::KEY_F9
   KEY_F10        = key::KEY_F10
   KEY_F11        = key::KEY_F11
   KEY_F12        = key::KEY_F12

   // Modifiers
   MOD_NONE       = key::MOD_NONE
   MOD_SHIFT      = key::MOD_SHIFT
   MOD_ALT        = key::MOD_ALT
   MOD_CTRL       = key::MOD_CTRL

   // Event kinds
   EV_NONE        = key::EV_NONE
   EV_KEY         = key::EV_KEY
   EV_MOUSE       = key::EV_MOUSE
   EV_RESIZE      = key::EV_RESIZE
   EV_THEME       = key::EV_THEME

   // Color scheme values (EV_THEME event.code)
   THEME_UNKNOWN  = key::THEME_UNKNOWN
   THEME_DARK     = key::THEME_DARK
   THEME_LIGHT    = key::THEME_LIGHT

   // Mouse actions & buttons
   MOUSE_PRESS        = key::MOUSE_PRESS
   MOUSE_RELEASE      = key::MOUSE_RELEASE
   MOUSE_DRAG         = key::MOUSE_DRAG
   MOUSE_SCROLL_UP    = key::MOUSE_SCROLL_UP
   MOUSE_SCROLL_DOWN  = key::MOUSE_SCROLL_DOWN
   MOUSE_BTN_LEFT     = key::MOUSE_BTN_LEFT
   MOUSE_BTN_MIDDLE   = key::MOUSE_BTN_MIDDLE
   MOUSE_BTN_RIGHT    = key::MOUSE_BTN_RIGHT
   MOUSE_BTN_NONE     = key::MOUSE_BTN_NONE

   // Style attributes
   ATTR_NONE      = style::ATTR_NONE
   ATTR_BOLD      = style::ATTR_BOLD
   ATTR_DIM       = style::ATTR_DIM
   ATTR_ITALIC    = style::ATTR_ITALIC
   ATTR_UNDERLINE = style::ATTR_UNDERLINE
   ATTR_REVERSE   = style::ATTR_REVERSE

   // Borders
   BORDER_SINGLE  = style::BORDER_SINGLE
   BORDER_ROUNDED = style::BORDER_ROUNDED
   BORDER_DOUBLE  = style::BORDER_DOUBLE
   BORDER_ASCII   = style::BORDER_ASCII

   // Alignment
   ALIGN_LEFT     = grid::ALIGN_LEFT
   ALIGN_CENTER   = grid::ALIGN_CENTER
   ALIGN_RIGHT    = grid::ALIGN_RIGHT

   // Colors & Color Operations
   COLOR_DEFAULT  = style::COLOR_DEFAULT
   rgb: Int, Int, Int => Int
   rgb = r, g, b => style::rgb(r, g, b)

   blend: Int, Int, Int => Int
   blend = c1, c2, t => style::blend(c1, c2, t)

   lighten: Int, Int => Int
   lighten = c, p => style::lighten(c, p)

   darken: Int, Int => Int
   darken = c, p => style::darken(c, p)

   grayscale: Int => Int
   grayscale = c => style::grayscale(c)

   // Palette Type & Presets
   #type Palette style::Palette
   CATPPUCCIN      = style::CATPPUCCIN
   MONOKAI         = style::MONOKAI
   NORD            = style::NORD
   TOKYONIGHT      = style::TOKYONIGHT
   SOLARIZED_DARK  = style::SOLARIZED_DARK
   SOLARIZED_LIGHT = style::SOLARIZED_LIGHT
   GRUVBOX_DARK    = style::GRUVBOX_DARK
   ONE_DARK        = style::ONE_DARK
   DRACULA         = style::DRACULA
   ROSE_PINE       = style::ROSE_PINE

   // Hardware Cursor Shapes
   CURSOR_DEFAULT          = raw::CURSOR_DEFAULT
   CURSOR_BLOCK            = raw::CURSOR_BLOCK
   CURSOR_BLOCK_STEADY     = raw::CURSOR_BLOCK_STEADY
   CURSOR_UNDERLINE        = raw::CURSOR_UNDERLINE
   CURSOR_UNDERLINE_STEADY = raw::CURSOR_UNDERLINE_STEADY
   CURSOR_BEAM             = raw::CURSOR_BEAM
   CURSOR_BEAM_STEADY      = raw::CURSOR_BEAM_STEADY

   // Escape string constant
   ESC = raw::ESC

   // Event constructors
   ev_none: () => key::Event
   ev_none = !=> key::ev_none!

   ev_key: Int, Int, Int => key::Event
   ev_key = code, ch, mods => key::ev_key(code, ch, mods)

   ev_char: Int => key::Event
   ev_char = c => key::ev_char(c)

   ev_code: Int => key::Event
   ev_code = code => key::ev_code(code)

   ev_ctrl: Int => key::Event
   ev_ctrl = c => key::ev_ctrl(c)

   ev_mouse: Int, Int, Int, Int, Int => key::Event
   ev_mouse = act, btn, mods, x, y => key::ev_mouse(act, btn, mods, x, y)

   ev_resize: Int, Int => key::Event
   ev_resize = rows, cols => key::ev_resize(rows, cols)

   ev_theme: Int, Int => key::Event
   ev_theme = scheme, bg => key::ev_theme(scheme, bg)

   // Types
   #type Event key::Event
   #type Grid  grid::Grid

   // Primary Terminal Context
   #type Term (
      orig_termios: Addr,
      raw_termios: Addr,
      is_raw: <>,
      is_mouse: <>,
      is_dark: <>,
      bg_color: Int,
      rows: Int,
      cols: Int,
      front: grid::Grid,
      back: grid::Grid
   )

   // Initialize terminal subsystem
   init: () => Term
   init = !=>
      // struct termios is 60 bytes on Linux and 72 on macOS
      orig_t = {128}
      raw_t = {128}
      raw::init_termios(&orig_t, &raw_t)
      sz = raw::get_size!
      r = sz(0)
      c = sz(1)
      front = grid::new(r, c)
      back = grid::new(r, c)
      Term((&orig_t, &raw_t, <->, <->, <+>, style::COLOR_DEFAULT, r, c, front, back))

   // Query terminal color scheme (CSI ? 996 n + OSC 11) and update t.is_dark / t.bg_color
   detect_theme: Term => <>
   detect_theme = t =>
      res = input::detect_theme(50)
      res.0 != key::THEME_UNKNOWN |
         t.is_dark = (res.0 == key::THEME_DARK)
      res.1 != style::COLOR_DEFAULT |
         t.bg_color = res.1
      t.is_dark

   // Whether the terminal is currently using a dark color scheme
   is_dark: Term => <>
   is_dark = t => t.is_dark

   // Detected 24-bit RGB background color (or COLOR_DEFAULT if unknown)
   bg_color: Term => Int
   bg_color = t => t.bg_color

   // Shutdown and clean up resources
   shutdown: Term => ()
   shutdown = t =>
      t.is_mouse |
         raw::disable_mouse!
         t.is_mouse = <->
      raw::exit_alt_screen!
      raw::show_cursor!
      raw::disable_bracketed_paste!
      raw::set_cursor_shape(raw::CURSOR_DEFAULT)
      raw::write_raw("\e[0m")
      raw::disable_raw_termios(t.orig_termios)
      t.is_raw = <->

   // Enable raw mode and alternate screen
   enable_raw: Term => ()
   enable_raw = t =>
      !raw::set_raw_termios(t.raw_termios) | --|
      t.is_raw = <+>
      raw::enter_alt_screen!
      dark = detect_theme(t)

   // Disable raw mode and restore screen
   disable_raw: Term => ()
   disable_raw = t =>
      t.is_mouse |
         raw::disable_mouse!
         t.is_mouse = <->
      raw::exit_alt_screen!
      raw::disable_raw_termios(t.orig_termios)
      t.is_raw = <->

   // Toggle mouse event tracking
   enable_mouse: Term => ()
   enable_mouse = t =>
      raw::enable_mouse!
      t.is_mouse = <+>

   disable_mouse: Term => ()
   disable_mouse = t =>
      raw::disable_mouse!
      t.is_mouse = <->

   // Check and resize grid buffers if window dimensions changed
   refresh_size: Term => <>
   refresh_size = t =>
      sz = raw::get_size!
      new_r = sz(0)
      new_c = sz(1)
      new_r != t.rows || new_c != t.cols
         |
            t.front = grid::new(new_r, new_c)
            t.back = grid::new(new_r, new_c)
            t.rows = new_r
            t.cols = new_c
            raw::clear_screen!
            <+>
         | <->

   // Poll event with window resize and live theme change detection
   poll_event: Term, Int => key::Event
   poll_event = t, timeout_ms =>
      refresh_size(t)
         | key::ev_resize(t.rows, t.cols)
         |
            ev = input::poll_event(timeout_ms)
            ev.kind == key::EV_THEME |
               t.is_dark = (ev.code != key::THEME_LIGHT)
               ev.ch != style::COLOR_DEFAULT |
                  t.bg_color = ev.ch
            ev

   // Force full redraw by clearing screen and resetting front buffer
   force_redraw: Term => ()
   force_redraw = t =>
      sz = raw::get_size!
      new_r = sz(0)
      new_c = sz(1)
      t.rows = new_r
      t.cols = new_c
      t.front = grid::new_invalid(new_r, new_c)
      t.back = grid::new(new_r, new_c)
      raw::clear_screen!

   // Render back buffer diff to screen
   render: Term => ()
   render = t =>
      grid::render_diff(t.front, t.back, t.rows, t.cols)

   // Clear back buffer
   clear: Term => ()
   clear = t =>
      grid::clear(t.back)

   // Drawing delegates for convenience
   set_cell: Term, Int, Int, Int, Int, Int, Int => ()
   set_cell = t, r, c, ch, fg, bg, attr =>
      grid::set(t.back, r, c, ch, fg, bg, attr)

   put_str: Term, Int, Int, String, Int, Int, Int => ()
   put_str = t, r, c, text, fg, bg, attr =>
      grid::put_str(t.back, r, c, text, fg, bg, attr)

   put_str_clipped: Term, Int, Int, String, Int, Int, Int, Int => ()
   put_str_clipped = t, r, c, text, max_w, fg, bg, attr =>
      grid::put_str_clipped(t.back, r, c, text, max_w, fg, bg, attr)

   put_str_aligned: Term, Int, Int, String, Int, Int, Int, Int, Int => ()
   put_str_aligned = t, r, c, text, width, align, fg, bg, attr =>
      grid::put_str_aligned(t.back, r, c, text, width, align, fg, bg, attr)

   fill_rect: Term, Int, Int, Int, Int, Int, Int, Int, Int => ()
   fill_rect = t, r, c, h, w, ch, fg, bg, attr =>
      grid::fill_rect(t.back, r, c, h, w, ch, fg, bg, attr)

   draw_box: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_box = t, r, c, h, w, style, fg, bg =>
      grid::draw_box(t.back, r, c, h, w, style, fg, bg)

   draw_titled_box: Term, Int, Int, Int, Int, Int, String, Int, Int, Int => ()
   draw_titled_box = t, r, c, h, w, style, title, fg, bg, title_fg =>
      grid::draw_titled_box(t.back, r, c, h, w, style, title, fg, bg, title_fg)

   draw_hline: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_hline = t, r, c, len, ch, fg, bg, attr =>
      grid::draw_hline(t.back, r, c, len, ch, fg, bg, attr)

   draw_vline: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_vline = t, r, c, len, ch, fg, bg, attr =>
      grid::draw_vline(t.back, r, c, len, ch, fg, bg, attr)

   // Hardware Cursor Positioning & Visibility
   set_cursor: Term, Int, Int => ()
   set_cursor = t, r, c =>
      raw::move_cursor(r + 1, c + 1)

   show_cursor: Term => ()
   show_cursor = t => raw::show_cursor!

   hide_cursor: Term => ()
   hide_cursor = t => raw::hide_cursor!

   set_cursor_shape: Term, Int => ()
   set_cursor_shape = t, shape => raw::set_cursor_shape(shape)

   // Terminal window title
   set_title: Term, String => ()
   set_title = t, title => raw::set_title(title)

   // Copy text to system clipboard via OSC 52
   copy_to_clipboard: Term, String => ()
   copy_to_clipboard = t, text => raw::copy_to_clipboard(text)

   // Viewport / Subgrid Window
   #type Window grid::Window
   create_window: Term, Int, Int, Int, Int => grid::Window
   create_window = t, r, c, h, w =>
      grid::win_new(t.back, r, c, h, w)

   hello: () => String
   hello = !=> "Hello from term!"
