// term/src/term.dva — High-performance, zero-flicker Edva terminal library

#use str
#use "key"
#use "style"
#use "raw"
#use "grid"
#use "input"

#public
   // --- Re-exports from submodules ---
   // Key codes
   KEY_NONE       = key::KEY_NONE
   KEY_CHAR       = key::KEY_CHAR
   KEY_UP         = key::KEY_UP
   KEY_DOWN       = key::KEY_DOWN
   KEY_LEFT       = key::KEY_LEFT
   KEY_RIGHT      = key::KEY_RIGHT
   KEY_HOME       = key::KEY_HOME
   KEY_END        = key::KEY_END
   KEY_PAGE_UP    = key::KEY_PAGE_UP
   KEY_PAGE_DOWN  = key::KEY_PAGE_DOWN
   KEY_BACKSPACE  = key::KEY_BACKSPACE
   KEY_DELETE     = key::KEY_DELETE
   KEY_ENTER      = key::KEY_ENTER
   KEY_TAB        = key::KEY_TAB
   KEY_BACKTAB    = key::KEY_BACKTAB
   KEY_ESC        = key::KEY_ESC
   KEY_CTRL       = key::KEY_CTRL
   KEY_ALT        = key::KEY_ALT
   KEY_INSERT     = key::KEY_INSERT
   KEY_F1         = key::KEY_F1
   KEY_F2         = key::KEY_F2
   KEY_F3         = key::KEY_F3
   KEY_F4         = key::KEY_F4
   KEY_F5         = key::KEY_F5
   KEY_F6         = key::KEY_F6
   KEY_F7         = key::KEY_F7
   KEY_F8         = key::KEY_F8
   KEY_F9         = key::KEY_F9
   KEY_F10        = key::KEY_F10
   KEY_F11        = key::KEY_F11
   KEY_F12        = key::KEY_F12

   // Modifiers
   MOD_NONE       = key::MOD_NONE
   MOD_SHIFT      = key::MOD_SHIFT
   MOD_ALT        = key::MOD_ALT
   MOD_CTRL       = key::MOD_CTRL

   // Event kinds
   EV_NONE        = key::EV_NONE
   EV_KEY         = key::EV_KEY
   EV_MOUSE       = key::EV_MOUSE
   EV_RESIZE      = key::EV_RESIZE

   // Mouse actions & buttons
   MOUSE_PRESS        = key::MOUSE_PRESS
   MOUSE_RELEASE      = key::MOUSE_RELEASE
   MOUSE_DRAG         = key::MOUSE_DRAG
   MOUSE_SCROLL_UP    = key::MOUSE_SCROLL_UP
   MOUSE_SCROLL_DOWN  = key::MOUSE_SCROLL_DOWN
   MOUSE_BTN_LEFT     = key::MOUSE_BTN_LEFT
   MOUSE_BTN_MIDDLE   = key::MOUSE_BTN_MIDDLE
   MOUSE_BTN_RIGHT    = key::MOUSE_BTN_RIGHT
   MOUSE_BTN_NONE     = key::MOUSE_BTN_NONE

   // Style attributes
   ATTR_NONE      = style::ATTR_NONE
   ATTR_BOLD      = style::ATTR_BOLD
   ATTR_DIM       = style::ATTR_DIM
   ATTR_ITALIC    = style::ATTR_ITALIC
   ATTR_UNDERLINE = style::ATTR_UNDERLINE
   ATTR_REVERSE   = style::ATTR_REVERSE

   // Borders
   BORDER_SINGLE  = style::BORDER_SINGLE
   BORDER_ROUNDED = style::BORDER_ROUNDED
   BORDER_DOUBLE  = style::BORDER_DOUBLE
   BORDER_ASCII   = style::BORDER_ASCII

   // Alignment
   ALIGN_LEFT     = grid::ALIGN_LEFT
   ALIGN_CENTER   = grid::ALIGN_CENTER
   ALIGN_RIGHT    = grid::ALIGN_RIGHT

   // Colors
   COLOR_DEFAULT  = style::COLOR_DEFAULT
   rgb: Int, Int, Int => Int
   rgb = r, g, b => style::rgb(r, g, b)

   // Escape string constant
   ESC = raw::ESC

   // Event constructors
   ev_none: () => key::Event
   ev_none = !=> key::ev_none!

   ev_key: Int, Int, Int => key::Event
   ev_key = code, ch, mods => key::ev_key(code, ch, mods)

   ev_char: Int => key::Event
   ev_char = c => key::ev_char(c)

   ev_code: Int => key::Event
   ev_code = code => key::ev_code(code)

   ev_ctrl: Int => key::Event
   ev_ctrl = c => key::ev_ctrl(c)

   ev_mouse: Int, Int, Int, Int, Int => key::Event
   ev_mouse = act, btn, mods, x, y => key::ev_mouse(act, btn, mods, x, y)

   ev_resize: Int, Int => key::Event
   ev_resize = rows, cols => key::ev_resize(rows, cols)

   // Types
   #type Event key::Event
   #type Grid  grid::Grid

   // Primary Terminal Context
   #type Term (
      orig_termios: Addr,
      raw_termios: Addr,
      is_raw: <>,
      is_mouse: <>,
      rows: Int,
      cols: Int,
      front: grid::Grid,
      back: grid::Grid
   )

   // Initialize terminal subsystem
   init: () => Term
   init = !=>
      orig_t = {64}
      raw_t = {64}
      sz = raw::get_size!
      r = sz(0)
      c = sz(1)
      front = grid::new(r, c)
      back = grid::new(r, c)
      Term((&orig_t, &raw_t, <->, <->, r, c, front, back))

   // Shutdown and clean up resources
   shutdown: Term => ()
   shutdown = t =>
      t.is_mouse | raw::disable_mouse!
      t.is_raw   | disable_raw(t)
      grid::free(t.front)
      grid::free(t.back)

   // Enable raw mode and alternate screen
   enable_raw: Term => ()
   enable_raw = t =>
      !raw::enable_raw_termios(t.orig_termios, t.raw_termios) | --|
      t.is_raw = <+>
      raw::enter_alt_screen!

   // Disable raw mode and restore screen
   disable_raw: Term => ()
   disable_raw = t =>
      t.is_mouse |
         raw::disable_mouse!
         t.is_mouse = <->
      raw::exit_alt_screen!
      raw::disable_raw_termios(t.orig_termios)
      t.is_raw = <->

   // Toggle mouse event tracking
   enable_mouse: Term => ()
   enable_mouse = t =>
      raw::enable_mouse!
      t.is_mouse = <+>

   disable_mouse: Term => ()
   disable_mouse = t =>
      raw::disable_mouse!
      t.is_mouse = <->

   // Check and resize grid buffers if window dimensions changed
   refresh_size: Term => <>
   refresh_size = t =>
      sz = raw::get_size!
      new_r = sz(0)
      new_c = sz(1)
      new_r != t.rows || new_c != t.cols
         |
            grid::free(t.front)
            grid::free(t.back)
            t.front = grid::new(new_r, new_c)
            t.back = grid::new(new_r, new_c)
            t.rows = new_r
            t.cols = new_c
            raw::clear_screen!
            <+>
         | <->

   // Poll event with window resize detection
   poll_event: Term, Int => key::Event
   poll_event = t, timeout_ms =>
      refresh_size(t)
         | key::ev_resize(t.rows, t.cols)
         | input::poll_event(timeout_ms)

   // Render back buffer diff to screen
   render: Term => ()
   render = t =>
      grid::render_diff(t.front, t.back, t.rows, t.cols)

   // Clear back buffer
   clear: Term => ()
   clear = t =>
      grid::clear(t.back)

   // Drawing delegates for convenience
   set_cell: Term, Int, Int, Int, Int, Int, Int => ()
   set_cell = t, r, c, ch, fg, bg, attr =>
      grid::set(t.back, r, c, ch, fg, bg, attr)

   put_str: Term, Int, Int, String, Int, Int, Int => ()
   put_str = t, r, c, text, fg, bg, attr =>
      grid::put_str(t.back, r, c, text, fg, bg, attr)

   put_str_clipped: Term, Int, Int, String, Int, Int, Int, Int => ()
   put_str_clipped = t, r, c, text, max_w, fg, bg, attr =>
      grid::put_str_clipped(t.back, r, c, text, max_w, fg, bg, attr)

   put_str_aligned: Term, Int, Int, String, Int, Int, Int, Int, Int => ()
   put_str_aligned = t, r, c, text, width, align, fg, bg, attr =>
      grid::put_str_aligned(t.back, r, c, text, width, align, fg, bg, attr)

   fill_rect: Term, Int, Int, Int, Int, Int, Int, Int, Int => ()
   fill_rect = t, r, c, h, w, ch, fg, bg, attr =>
      grid::fill_rect(t.back, r, c, h, w, ch, fg, bg, attr)

   draw_box: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_box = t, r, c, h, w, style, fg, bg =>
      grid::draw_box(t.back, r, c, h, w, style, fg, bg)

   draw_titled_box: Term, Int, Int, Int, Int, Int, String, Int, Int, Int => ()
   draw_titled_box = t, r, c, h, w, style, title, fg, bg, title_fg =>
      grid::draw_titled_box(t.back, r, c, h, w, style, title, fg, bg, title_fg)

   draw_hline: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_hline = t, r, c, len, ch, fg, bg, attr =>
      grid::draw_hline(t.back, r, c, len, ch, fg, bg, attr)

   draw_vline: Term, Int, Int, Int, Int, Int, Int, Int => ()
   draw_vline = t, r, c, len, ch, fg, bg, attr =>
      grid::draw_vline(t.back, r, c, len, ch, fg, bg, attr)

   hello: () => String
   hello = !=> "Hello from term!"
