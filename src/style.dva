// term/src/style.dva — Colors, attributes, palettes, and border styles

#public
   // --- Text Attribute Bitmask ---
   ATTR_NONE      = 0
   ATTR_BOLD      = 1
   ATTR_DIM       = 2
   ATTR_ITALIC    = 4
   ATTR_UNDERLINE = 8
   ATTR_REVERSE   = 16

   // Default color sentinel (-1 signifies default terminal color)
   COLOR_DEFAULT  = -1

   // Color packing helper (24-bit TrueColor: 0xRRGGBB)
   rgb: Int, Int, Int => Int
   rgb = r, g, b =>
      ((r .&. 255) .<. 16) .|. ((g .&. 255) .<. 8) .|. (b .&. 255)

   // Unpack RGB
   red: Int => Int
   red = c => (c .>. 16) .&. 255

   green: Int => Int
   green = c => (c .>. 8) .&. 255

   blue: Int => Int
   blue = c => c .&. 255

   // --- Standard 16 ANSI Palette ---
   BLACK          = 0x000000
   RED            = 0xcd3131
   GREEN          = 0x0dbc79
   YELLOW         = 0xe5e510
   BLUE           = 0x2472c8
   MAGENTA        = 0xbc3fbc
   CYAN           = 0x11a8cd
   WHITE          = 0xe5e5e5

   BRIGHT_BLACK   = 0x666666
   BRIGHT_RED     = 0xf14c4c
   BRIGHT_GREEN   = 0x23d18b
   BRIGHT_YELLOW  = 0xf5f543
   BRIGHT_BLUE    = 0x3b8eea
   BRIGHT_MAGENTA = 0xd670d6
   BRIGHT_CYAN    = 0x29b8db
   BRIGHT_WHITE   = 0xffffff

   // --- Modern Theme Palette (Catppuccin Mocha / TokyoNight inspired) ---
   ROSEWATER      = 0xf5e0dc
   FLAMINGO       = 0xf2cdcd
   PINK           = 0xf5c2e7
   MAUVE          = 0xcba6f7
   RED_ACCENT     = 0xf38ba8
   MAROON         = 0xeba0ac
   PEACH          = 0xfab387
   YELLOW_ACCENT  = 0xf9e2af
   GREEN_ACCENT   = 0xa6e3a1
   TEAL           = 0x94e2d5
   SKY            = 0x89dceb
   SAPPHIRE       = 0x74c7ec
   BLUE_ACCENT    = 0x89b4fa
   LAVENDER       = 0xb4befe
   TEXT           = 0xcdd6f4
   SUBTEXT        = 0xa6adc8
   OVERLAY        = 0x6c7086
   SURFACE        = 0x313244
   BASE           = 0x1e1e2e
   MANTLE         = 0x181825
   CRUST          = 0x11111b

   // --- Border Styles ---
   BORDER_SINGLE  = 0   // ┌ ─ ┐ │ └ ┘
   BORDER_ROUNDED = 1   // ╭ ─ ╮ │ ╰ ╯
   BORDER_DOUBLE  = 2   // ╔ ═ ╗ ║ ╚ ╝
   BORDER_ASCII   = 3   // + - + | + +

   // Box characters for a border style (tl, tr, bl, br, h, v)
   // Returns (top_left, top_right, bot_left, bot_right, horiz, vert)
   border_chars: Int => (Int, Int, Int, Int, Int, Int)
   border_chars = style =>
      style == BORDER_ROUNDED
         | (0x256D, 0x256E, 0x2570, 0x256F, 0x2500, 0x2502) // ╭ ╮ ╰ ╯ ─ │
         | style == BORDER_DOUBLE
            | (0x2554, 0x2557, 0x255A, 0x255D, 0x2550, 0x2551) // ╔ ╗ ╚ ╝ ═ ║
            | style == BORDER_ASCII
               | (43, 43, 43, 43, 45, 124) // + + + + - |
               | (0x250C, 0x2510, 0x2514, 0x2518, 0x2500, 0x2502) // ┌ ┐ └ ┘ ─ │ (BORDER_SINGLE)
