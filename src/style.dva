// term/src/style.dva — Colors, attributes, palettes, and border styles

#use color
#use "color/palette"

#public
   // --- Text Attribute Bitmask ---
   ATTR_NONE      = 0
   ATTR_BOLD      = 1
   ATTR_DIM       = 2
   ATTR_ITALIC    = 4
   ATTR_UNDERLINE = 8
   ATTR_REVERSE   = 16

   // Default color sentinel (-1 signifies default terminal color)
   COLOR_DEFAULT  = -1

   // Color operations delegated to std/color
   rgb: Int, Int, Int => Int
   rgb = r, g, b => color::pack_rgb(r, g, b)

   red: Int => Int
   red = c => color::red(c)

   green: Int => Int
   green = c => color::green(c)

   blue: Int => Int
   blue = c => color::blue(c)

   blend: Int, Int, Int => Int
   blend = c1, c2, t => color::blend(c1, c2, t)

   lighten: Int, Int => Int
   lighten = c, p => color::lighten(c, p)

   darken: Int, Int => Int
   darken = c, p => color::darken(c, p)

   grayscale: Int => Int
   grayscale = c => color::grayscale(c)

   // Palette type & Presets from std/color/palette
   #type Palette palette::Palette
   CATPPUCCIN      = palette::CATPPUCCIN
   MONOKAI         = palette::MONOKAI
   NORD            = palette::NORD
   TOKYONIGHT      = palette::TOKYONIGHT
   SOLARIZED_DARK  = palette::SOLARIZED_DARK
   SOLARIZED_LIGHT = palette::SOLARIZED_LIGHT
   GRUVBOX_DARK    = palette::GRUVBOX_DARK
   ONE_DARK        = palette::ONE_DARK
   DRACULA         = palette::DRACULA
   ROSE_PINE       = palette::ROSE_PINE

   // --- Border Styles ---
   BORDER_SINGLE  = 0   // ┌ ─ ┐ │ └ ┘
   BORDER_ROUNDED = 1   // ╭ ─ ╮ │ ╰ ╯
   BORDER_DOUBLE  = 2   // ╔ ═ ╗ ║ ╚ ╝
   BORDER_ASCII   = 3   // + - + | + +

   // Box characters for a border style (tl, tr, bl, br, h, v)
   // Returns (top_left, top_right, bot_left, bot_right, horiz, vert)
   border_chars: Int => (Int, Int, Int, Int, Int, Int)
   border_chars = style =>
      style
         [== BORDER_ROUNDED] (0x256D, 0x256E, 0x2570, 0x256F, 0x2500, 0x2502) // ╭ ╮ ╰ ╯ ─ │
         [== BORDER_DOUBLE]  (0x2554, 0x2557, 0x255A, 0x255D, 0x2550, 0x2551) // ╔ ╗ ╚ ╝ ═ ║
         [== BORDER_ASCII]   (43, 43, 43, 43, 45, 124)                         // + + + + - |
         | (0x250C, 0x2510, 0x2514, 0x2518, 0x2500, 0x2502)                   // ┌ ┐ └ ┘ ─ │ (BORDER_SINGLE)
